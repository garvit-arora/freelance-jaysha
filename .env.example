VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOGIN_EMAIL=
# Additional sign-in emails, separated by commas; all use LOGIN_PASSWORD.
LOGIN_EMAILS=
LOGIN_PASSWORD=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
SITE_URL=http://localhost:5173

# Supabase personal access token, needed only for the one-time cloud deployment
SUPABASE_ACCESS_TOKEN=

# Browser key for in-page Street View; restrict to your website domains.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Public audio URL or a path such as /song.mp3 (add the file to public).
VITE_BACKGROUND_MUSIC_URL=

# Formspark action URL; recipient settings are managed in the Formspark dashboard. Only new submissions are forwarded.
FORMSPARK_HELPDESK_URL=
